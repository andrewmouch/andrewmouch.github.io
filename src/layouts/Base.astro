---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import TitleBlock from '../components/TitleBlock.astro';
interface Props {
  title: string; description?: string; fullscreen?: boolean;
  grid?: 'square' | 'none' | 'desk'; nav?: boolean;

  sheetTitle?: string; sheet?: string; rev?: string; scale?: string;
  legend?: boolean;
}
const {
  title,
  description = 'Mechatronics projects, notes, and experiments.',
  fullscreen = false,
  grid = 'square',
  nav = true,
  sheetTitle = 'Index / Landing',
  sheet = '01/05',
  rev = 'C',
  scale = '1:1',
  legend = true,
} = Astro.props;
const cls = [
  fullscreen && 'fullscreen',
  grid === 'none' && 'no-grid',
  grid === 'desk' && 'desk-surface',
].filter(Boolean).join(' ');
---
<!doctype html>
<html lang="en" class={cls || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.ico?v=4" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon.png?v=4" sizes="272x272" />
    <link rel="apple-touch-icon" href="/favicon.png?v=4" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Serif:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    {nav && <Nav />}
    <slot />
    {legend && <TitleBlock title={sheetTitle} sheet={sheet} rev={rev} scale={scale} fixed={fullscreen} />}
  </body>
</html>
